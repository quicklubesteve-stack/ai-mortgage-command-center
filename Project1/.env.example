# ==============================================================================
# MORTGAGE FILTRATION AGENT & AUTHORIZATION SYSTEM ENVIRONMENT TEMPLATE
# Copy this file to .env and customize values for your deployment
# ==============================================================================

# Application & Server Settings
PORT=3000
NODE_ENV=development
CORS_ALLOWED_ORIGINS=*

# Authorized Human Underwriter Settings (Protocol Zero Guardrail)
HUMAN_OFFICER_NAME=Steve
HUMAN_OFFICER_TITLE=Lead Mortgage Underwriter
HUMAN_OFFICER_EMAIL=steve@apexmortgage.com
HUMAN_OFFICER_NMLS_ID=NMLS-1948210

# Underwriting Thresholds & Conforming Limits (2026 Baseline)
CONFORMING_LOAN_LIMIT=766550
MAX_CONVENTIONAL_DTI=43.0
MAX_FHA_DTI=50.0
MIN_CONVENTIONAL_FICO=620
MIN_FHA_FICO=580

# Database Persistence (PostgreSQL / Supabase / Neon)
DATABASE_URL=postgres://username:password@localhost:5432/mortgage_db

# Security & Audit Log Encryption
SESSION_SECRET=replace_with_a_secure_random_string_in_production

# Institutional Wholesale Pricing Engine (PPE) Credentials (Optional)
OPTIMAL_BLUE_API_KEY=
OPTIMAL_BLUE_ACCOUNT_ID=
POLLY_MARKETPLACE_API_KEY=

# Loan Origination System (LOS) Integration (Encompass / Blend)
ENCOMPASS_INSTANCE_ID=
ENCOMPASS_CLIENT_ID=
ENCOMPASS_CLIENT_SECRET=

# Omnichannel SMS / WhatsApp Intake (Twilio API)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
