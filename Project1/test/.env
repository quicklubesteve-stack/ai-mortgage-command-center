# ==============================================================================
# MORTGAGE FILTRATION AGENT & AUTHORIZATION SYSTEM ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application & Server Settings
PORT=3000
NODE_ENV=development
CORS_ALLOWED_ORIGINS=*

# Authorized Human Underwriter Settings (Protocol Zero Guardrail)
# Final credit determination is reserved 100% for this officer
HUMAN_OFFICER_NAME=Steve
HUMAN_OFFICER_TITLE=Lead Mortgage Underwriter
HUMAN_OFFICER_EMAIL=steve@apexmortgage.com
HUMAN_OFFICER_NMLS_ID=NMLS-1948210

# Underwriting Thresholds & Conforming Limits (2026 Baseline)
CONFORMING_LOAN_LIMIT=766550
MAX_CONVENTIONAL_DTI=43.0
MAX_FHA_DTI=50.0
MIN_CONVENTIONAL_FICO=620
MIN_FHA_FICO=580

# Database Persistence (PostgreSQL / Supabase / Neon)
# Default local docker compose connection string:
DATABASE_URL=postgres://underwriter:secure_pass123@localhost:5432/mortgage_db

# Security & Audit Log Encryption (Replace in production)
SESSION_SECRET=super_secret_audit_ledger_encryption_key_2026_xyz987

# Institutional Wholesale Pricing Engine (PPE) Credentials (Optional / Production)
OPTIMAL_BLUE_API_KEY=your_optimal_blue_api_key_here
OPTIMAL_BLUE_ACCOUNT_ID=OB-ACCT-98124
POLLY_MARKETPLACE_API_KEY=your_polly_ppe_api_key_here

# Loan Origination System (LOS) Integration (ICE Encompass / Blend)
ENCOMPASS_INSTANCE_ID=be11029384
ENCOMPASS_CLIENT_ID=your_encompass_api_client_id
ENCOMPASS_CLIENT_SECRET=your_encompass_api_client_secret

# Omnichannel SMS / WhatsApp Intake (Twilio API)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+18005550199
