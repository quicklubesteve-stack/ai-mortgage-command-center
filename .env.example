# AI Mortgage Command Center — Environment Configuration
# Copy this file to .env for local development.
# Do NOT commit real secrets or production credentials to version control.

# Local SQLite database for demonstration (structured for PostgreSQL migration in production)
DATABASE_URL="file:./dev.db"

# Demo Mode & Human-in-the-Loop Governance
NEXT_PUBLIC_APP_NAME="AI Mortgage Command Center"
NEXT_PUBLIC_APP_TAGLINE="Smarter Mortgage Workflows. Human-Controlled Decisions."
NEXT_PUBLIC_DEMO_MODE="true"
HUMAN_UNDERWRITER_NAME="Steve"
HUMAN_UNDERWRITER_ROLE="Senior Mortgage Broker & Principal Underwriter"

# Configurable Canadian Mortgage Policy Assumptions (Dated Reference Baseline)
POLICY_EFFECTIVE_DATE="2026-01-01"
OSFI_BENCHMARK_FLOOR_RATE="5.25"
OSFI_STRESS_BUFFER_PCT="2.00"
STANDARD_MAX_GDS_PCT="39.0"
STANDARD_MAX_TDS_PCT="44.0"
INSURED_PRICE_CEILING_CAD="1500000"

# Future Production Placeholders (Not active in Demo Mode)
# POSTGRES_PRISMA_URL="postgresql://user:password@localhost:5432/mortgage_command_center?schema=public"
# NEXTAUTH_SECRET="replace-with-32-byte-hex-secret-in-production"
# FIELD_ENCRYPTION_KEY="replace-with-kms-key-id-in-production"
